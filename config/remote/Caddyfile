# TLS termination — proxy everything to server's Caddy via WireGuard
assistant.@domain@, medias.@domain@, files.@domain@, auth.@domain@, torrents.@domain@, prowlarr.@domain@, sonarr.@domain@, radarr.@domain@, shelfarr.@domain@, audiobooks.@domain@ {
  reverse_proxy https://@wg_server@ {
    header_up Host {host}
    header_up X-Forwarded-Proto {scheme}
    transport http {
      tls_insecure_skip_verify
      tls_server_name {host}
    }
  }
}
