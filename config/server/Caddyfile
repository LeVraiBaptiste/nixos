{
  servers {
    trusted_proxies static @edge_ip@
  }
}

(authelia) {
  forward_auth localhost:@authelia_port@ {
    uri /api/authz/forward-auth
    copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
  }
}

# Authelia portal
auth.@domain@ {
  tls internal
  reverse_proxy localhost:@authelia_port@
}

# Home Assistant (HTTPS for laptop/remote, HTTP for Android app on LAN)
assistant.@domain@ {
  tls internal
  reverse_proxy localhost:@ha_port@
}

http://assistant.@domain@ {
  reverse_proxy localhost:@ha_port@
}

# Jellyfin (has its own auth)
medias.@domain@ {
  tls internal
  reverse_proxy localhost:@jellyfin_port@
}

# FileBrowser
files.@domain@ {
  tls internal
  import authelia
  reverse_proxy localhost:@filebrowser_port@
}

# qBittorrent
torrents.@domain@ {
  tls internal
  import authelia
  reverse_proxy localhost:@qbittorrent_port@
}

# Prowlarr
prowlarr.@domain@ {
  tls internal
  import authelia
  reverse_proxy localhost:@prowlarr_port@
}

# Sonarr
sonarr.@domain@ {
  tls internal
  import authelia
  reverse_proxy localhost:@sonarr_port@
}

# Radarr
radarr.@domain@ {
  tls internal
  import authelia
  reverse_proxy localhost:@radarr_port@
}

# Shelfarr
shelfarr.@domain@ {
  tls internal
  import authelia
  reverse_proxy localhost:@shelfarr_port@
}

# Audiobookshelf (has its own auth)
audiobooks.@domain@ {
  tls internal
