{
  servers {
    trusted_proxies static @edge_ip@
  }
}

# Public certificates, pulled from remote (modules/nixos/edge-certs.nix)
(public_cert) {
  tls /certs/{args[0]}/{args[0]}.crt /certs/{args[0]}/{args[0]}.key
}

(authelia) {
  forward_auth localhost:@authelia_port@ {
    uri /api/authz/forward-auth
    copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
  }
}

# Authelia portal
auth.@domain@ {
  import public_cert auth.@domain@
  reverse_proxy localhost:@authelia_port@
}

# Home Assistant (HTTPS for laptop/remote, HTTP for Android app on LAN)
assistant.@domain@ {
  import public_cert assistant.@domain@
  reverse_proxy localhost:@ha_port@
}

http://assistant.@domain@ {
  reverse_proxy localhost:@ha_port@
}

# Jellyfin (has its own auth)
medias.@domain@ {
  import public_cert medias.@domain@
  reverse_proxy localhost:@jellyfin_port@
}

# FileBrowser
files.@domain@ {
  import public_cert files.@domain@
  import authelia
  reverse_proxy localhost:@filebrowser_port@
}

# qBittorrent
torrents.@domain@ {
  import public_cert torrents.@domain@
  import authelia
  reverse_proxy localhost:@qbittorrent_port@
}

# Prowlarr
