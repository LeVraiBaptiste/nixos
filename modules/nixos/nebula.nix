# Nebula mesh (network "homelab"): every pair of hosts gets its own end-to-end tunnel.
# remote is the lighthouse (address book) and relay of last resort, but it holds no CA
# key and only ever forwards ciphertext. On the home LAN, hosts talk directly.
#
# Trust: the CA key never touches a host (see scripts/nebula-cert.sh). Host keys are
# generated on each host in /etc/nebula/homelab.key; only certificates (public) are
# committed in nebula/. Until a host's certificate exists, the network stays disabled.
#
# Access control is Nebula's own firewall, keyed on certificate groups (vars.nebula):
# each host lists what it accepts in homelab.nebula.inbound.
{
  config,
  lib,
  pkgs,
  vars,
  ...
}:
let
  host = config.networking.hostName;
  n = vars.nebula;
  lighthouse = n.hosts.remote.ip;
  isLighthouse = host == "remote";

  ca = ../../nebula/ca.crt;
  cert = ../../nebula/${host}.crt;
  ready = builtins.pathExists ca && builtins.pathExists cert;
in
{
  options.homelab.nebula.inbound = lib.mkOption {
    type = lib.types.listOf lib.types.attrs;
    default = [ ];
    description = "Nebula firewall rules for inbound traffic on this host (ICMP is always allowed).";
    example = [
      {
        port = 22;
        proto = "tcp";
        group = "workstation";
      }
    ];
  };

  config = {
    # nebula-cert, to generate this host's key before it has a certificate
    environment.systemPackages = [ pkgs.nebula ];

    warnings = lib.optional (
      !ready
    ) "nebula: nebula/${host}.crt missing, mesh disabled (see docs/nebula-setup.md)";

    services.nebula.networks.homelab = lib.mkIf ready {
      inherit ca cert;
      key = "/etc/nebula/homelab.key";

      inherit isLighthouse;
      isRelay = isLighthouse;
      lighthouses = lib.optional (!isLighthouse) lighthouse;
      relays = lib.optional (!isLighthouse) lighthouse;
      staticHostMap = lib.optionalAttrs (!isLighthouse) {
        ${lighthouse} = [ "${vars.wireguard.remoteEndpoint}:${toString n.port}" ];
      };

      # Fixed port everywhere (opened by the module): LAN peers reach each other directly
      # instead of depending on hole punching through the local firewall.
      listen.port = n.port;

      settings = {
        # At home, prefer the LAN address of a peer over its public one
        preferred_ranges = [ n.lan ];
        punchy = {
          punch = true;
          respond = true;
        };
      };

      firewall = {
        outbound = [
          {
            port = "any";
            proto = "any";
            host = "any";
          }
        ];
        inbound = [
          {
            port = "any";
            proto = "icmp";
            host = "any";
          }
        ]
        ++ config.homelab.nebula.inbound;
      };
    };

    # The key is generated by hand; the daemon runs as nebula-homelab
    systemd.tmpfiles.rules = lib.mkIf ready [ "z /etc/nebula/homelab.key 0640 root nebula-homelab -" ];

    # Filtering happens in Nebula's firewall (by certificate group), not in iptables
    networking.firewall.trustedInterfaces = lib.mkIf ready [ "nebula.homelab" ];
  };
}
